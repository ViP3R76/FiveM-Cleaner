<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FiveM Cleaner</AssemblyName>
    <RootNamespace>FiveMCleaner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ReleasePublishDir>$(MSBuildProjectDirectory)\releases\</ReleasePublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\twitch.png" />
    <Resource Include="Assets\discord.png" />
    <Resource Include="Assets\kofi.png" />
    <Resource Include="Assets\github.png" />
  </ItemGroup>
  <Target Name="CreateReleaseOutput"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleasePublishDir>$(MSBuildProjectDirectory)\releases</ReleasePublishDir>
      <ReleaseExe>$(ReleasePublishDir)\FiveM-Cleaner.exe</ReleaseExe>
    </PropertyGroup>
    <RemoveDir Directories="$(ReleasePublishDir)" Condition="Exists('$(ReleasePublishDir)')" />
    <MakeDir Directories="$(ReleasePublishDir)" />
    <ItemGroup>
      <PublishedExe Include="$(PublishDir)*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedExe)"
          DestinationFiles="$(ReleaseExe)"
          SkipUnchangedFiles="false" />
    <Message Importance="High" Text="FiveM CLEANER: $(ReleaseExe)" />
  </Target>

</Project>
