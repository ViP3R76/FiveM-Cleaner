<Window x:Class="FiveMCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FiveM CLEANER - by ViP3R_76"
        Width="900" Height="600" MinWidth="900" MinHeight="600" MaxWidth="900" MaxHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D0D13" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="FiveM" Foreground="{StaticResource YellowBrush}" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text=" CLEANER" Foreground="{StaticResource PurpleBrush}" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text=" - by ViP3R_76" Foreground="{StaticResource MutedBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,3,0,0"/>
                    </StackPanel>
                    <Button Width="38" Height="32" HorizontalAlignment="Right" Content="×" Click="Close_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="20" Padding="0"/>
                </Grid>
            </Border>

            <!-- MAIN VIEW -->
            <Grid x:Name="MainView" Grid.Row="1" Margin="26,18,26,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="78"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="104"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="13" Height="13" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,11,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LblStatusHeader" Text="FIVEM STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="StatusText" Text="FiveM ist nicht gestartet" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock x:Name="StatusSubtext" Text="Cleanup bereit" Foreground="{StaticResource GreenBrush}" FontSize="11" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="RefreshButton" Width="40" Height="36" Content="↻" Click="Refresh_Click" ToolTip="Status aktualisieren" Padding="0" FontSize="15"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15,9">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse x:Name="InstallationDot" Width="13" Height="13" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,11,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LblInstallationHeader" Text="FIVEM INSTALLATION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="RootText" Text="FiveM" Foreground="{StaticResource TextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                <TextBlock x:Name="InstallationText" Text="Installation wird geprüft …" Foreground="{StaticResource GreenBrush}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CACHE -->
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblCache" Text="CACHE" Foreground="{StaticResource YellowBrush}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="LblCacheDescription" Text="Temporäre FiveM-Daten" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock x:Name="CacheSizeText" Text="0,0 MB" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="CacheTargetList" Grid.Row="1" Margin="0,10,0,8" VerticalAlignment="Center">
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CacheCheck1" Text="○" Foreground="{StaticResource MutedBrush}" FontSize="16"/><TextBlock Grid.Column="1" Text="FiveM.app\data\cache" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CacheCheck2" Text="○" Foreground="{StaticResource MutedBrush}" FontSize="16"/><TextBlock Grid.Column="1" Text="FiveM.app\data\nui-storage" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CacheCheck3" Text="○" Foreground="{StaticResource MutedBrush}" FontSize="16"/><TextBlock Grid.Column="1" Text="FiveM.app\data\server-cache" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/></Grid>
                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="CacheCheck4" Text="○" Foreground="{StaticResource MutedBrush}" FontSize="16"/><TextBlock Grid.Column="1" Text="FiveM.app\data\server-cache-priv" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center"/></Grid>
                            </StackPanel>
                            <Button Grid.Row="2" x:Name="CacheButton" Content="CACHE BEREINIGEN" Click="Cache_Click" Height="38" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- LOGS -->
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock x:Name="LblLogs" Text="LOGS" Foreground="{StaticResource YellowBrush}" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="LblLogsDescription" Text="FiveM Log-Dateien" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="LogsSizeText" Text="0,0 MB" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="LogsDetailText" Text="logs" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                            <Button Grid.Row="2" x:Name="LogsButton" Content="LOGS BEREINIGEN" Click="Logs_Click" Height="38" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- CRASH DUMPS -->
                    <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock x:Name="LblCrashes" Text="CRASH DUMPS" Foreground="{StaticResource YellowBrush}" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="LblCrashesDescription" Text="FiveM Absturz-Daten" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock x:Name="CrashesSizeText" Text="0,0 MB" Foreground="{StaticResource TextBrush}" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="CrashesDetailText" Text="crashes" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                            <Button Grid.Row="2" x:Name="CrashesButton" Content="DUMPS BEREINIGEN" Click="Crashes_Click" Height="38" FontSize="14" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,8,0" Background="#0D0D13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="13,8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="LblOperationStatus" Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock x:Name="OperationText" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <Run x:Name="OperationIconRun" Text="" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                                    <Run x:Name="OperationMessageRun" Text="Bereit. FiveM wird überwacht." Foreground="{StaticResource TextBrush}"/>
                                </TextBlock>
                                <TextBlock x:Name="OperationDetailsText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>
                            <Grid Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,7,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="CleanupProgressBar" Grid.Column="0" Height="10" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CleanupPercentText" Grid.Column="1" Text="0 %" Foreground="{StaticResource PurpleBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="CleanupCurrentText" Grid.Row="1" Text="" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <StackPanel Grid.Row="2" x:Name="ConfirmPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConfirmText" Text="Bereinigung durchführen?" Foreground="{StaticResource YellowBrush}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button x:Name="ConfirmYesButton" Content="JA" Width="50" Height="28" Margin="12,0,5,0"
                                        Padding="0" Click="ConfirmYes_Click" FontSize="11" FontWeight="Bold">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#09090D"/>
                                                    <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="ConfirmNoButton" Content="NEIN" Width="54" Height="28" Padding="0"
                                        Click="ConfirmNo_Click" FontSize="11" FontWeight="Bold">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" x:Name="AllButton" Content="ALLES BEREINIGEN" Click="All_Click" MouseEnter="AllButton_MouseEnter" MouseLeave="AllButton_MouseLeave" Height="104" FontSize="16" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/><Setter Property="Background" Value="#16111F"/><Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                                        <Setter Property="Background" Value="#1C1427"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{StaticResource YellowBrush}"/><Setter Property="Background" Value="#21172F"/></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>

            <!-- ABOUT VIEW: replaces the main view, not a popup/overlay -->
            <Grid x:Name="AboutView" Grid.Row="1" Margin="26,14,26,10" Visibility="Collapsed">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LblDisclaimer" Grid.Row="0" Text="DISCLAIMER &amp; RECHTE"
                                   Foreground="{StaticResource PurpleBrush}" FontSize="15" FontWeight="Bold"/>

                        <Border Grid.Row="2" Background="#0B0B10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="14,10">
                            <StackPanel>
                                <TextBlock x:Name="AboutDisclaimer1" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                           FontSize="14" LineHeight="20">
                                    FiveM CLEANER ist ein unabhängiges Community-Hilfsprogramm und steht in keiner offiziellen Verbindung zu Cfx.re, FiveM oder Rockstar Games. Das Programm wurde weder von diesen Unternehmen entwickelt, veröffentlicht, geprüft, autorisiert noch unterstützt.
                                </TextBlock>
                                <TextBlock x:Name="AboutDisclaimer2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           FontSize="13" LineHeight="19" Margin="0,7,0,0">
                                    FiveM, Cfx.re, Rockstar Games sowie zugehörige Namen, Logos, Marken, Software und Inhalte sind Eigentum ihrer jeweiligen Rechteinhaber. Alle Rechte verbleiben bei den jeweiligen Rechteinhabern. Namen und Marken werden ausschließlich zur Identifikation der unterstützten Software verwendet.
                                </TextBlock>
                                <TextBlock x:Name="AboutDisclaimer3" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                           FontSize="13" LineHeight="19" Margin="0,7,0,0">
                                    Die Nutzung erfolgt auf eigene Verantwortung. FiveM CLEANER verarbeitet ausschließlich die fest definierten Cache-, Log- und Crash-Dump-Verzeichnisse. Für Datenverlust, beschädigte Dateien, Fehlfunktionen oder sonstige Schäden wird – soweit gesetzlich zulässig – keine Haftung übernommen. Benötigte Logs oder Crash-Dumps sollten vor der Bereinigung gesichert werden.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="DiscordLinkButton" Grid.Column="0" Height="58"
                                    Click="Discord_Click" HorizontalContentAlignment="Left"
                                    Padding="10,0" Background="#17131F" FontSize="12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" Background="#5865F2" Margin="0,0,8,0">
                                        <Image Source="/Assets/discord.png" Width="23" Height="23" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LblDiscord" Text="DISCORD" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="discord.gg/9AxuZkyU7P" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="TwitchLinkButton" Grid.Column="2" Height="58"
                                    Click="Twitch_Click" HorizontalContentAlignment="Left"
                                    Padding="10,0" Background="#17131F" FontSize="12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" Background="#9146FF" Margin="0,0,8,0">
                                        <Image Source="/Assets/twitch.png" Width="22" Height="22" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LblTwitch" Text="TWITCH" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="twitch.tv/vip3r_76" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button x:Name="KofiLinkButton" Grid.Column="4" Height="58"
                                    Click="Kofi_Click" Padding="8,6" Background="#17131F"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    ToolTip="Ko-fi: ko-fi.com/vip3r76">
                                <Image Source="/Assets/kofi.png" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button x:Name="GitHubLinkButton" Grid.Column="6" Height="58"
                                    Click="GitHub_Click" HorizontalContentAlignment="Left"
                                    Padding="10,0" Background="#17131F" FontSize="12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" Background="#24292F" Margin="0,0,8,0">
                                        <Image Source="/Assets/github.png" Width="22" Height="22" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="LblGitHub" Text="GITHUB" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text="github.com/ViP3R76/FiveM-Cleaner" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button x:Name="LblClose" Grid.Row="5" Content="SCHLIESSEN" Width="140" Height="38"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,4,0,0" Click="AboutClose_Click"
                                FontSize="13" FontWeight="Bold"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Background="#0D0D13">
                <Button x:Name="AboutButton" Width="82" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Click="About_Click" Background="Transparent" BorderThickness="0" Padding="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource YellowBrush}"/></Trigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="ABOUT" FontSize="12" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="LanguageButton" Width="92" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="108,0,0,0" Click="Language_Click" Background="Transparent" BorderThickness="0" Padding="0"
                        ToolTip="Deutsch / English">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Foreground" Value="{StaticResource PurpleBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource YellowBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock x:Name="LanguageButtonText" Text="SPRACHE" FontSize="12" FontWeight="Bold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
<TextBlock x:Name="FooterVersionText" Text="v1.20.0" Foreground="{StaticResource PurpleBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
